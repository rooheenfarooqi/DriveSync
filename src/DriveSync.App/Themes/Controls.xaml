<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DriveSync.App.Controls"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- Component styles from the design's Components & states page: rest, hover, pressed, disabled,
         focus (2-px accent ring, 2 px out) and error. Colours come from Tokens.xaml. -->

    <!-- ===== Focus ring ===== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusRingRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="999" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text ===== -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource FsXl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsCap}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsMd}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Faint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="err"><Setter Property="Foreground" Value="{DynamicResource ErrBrush}" /></Trigger>
            <Trigger Property="Tag" Value="warn"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></Trigger>
            <Trigger Property="Tag" Value="ok"><Setter Property="Foreground" Value="{DynamicResource OkBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RLg}" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="CardFlush" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <LinearGradientBrush x:Key="BtnBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#13FFFFFF" Offset="0" />
        <GradientStop Color="#13FFFFFF" Offset="0.92" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Buttons ===== -->
    <Style TargetType="c:UiButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{DynamicResource Layer2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BtnBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:UiButton">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <c:Icon x:Name="Ic" Kind="{TemplateBinding Icon}" Size="16" Spin="{TemplateBinding SpinIcon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="Cp" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value=""><Setter TargetName="Ic" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Ic" Property="Margin" Value="0" /></Trigger>
                        <Trigger Property="IconOnly" Value="True">
                            <Setter TargetName="Cp" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Ic" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Small" Value="True">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12.5" />
            </Trigger>
            <Trigger Property="IconOnly" Value="True">
                <Setter Property="Width" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IconOnly" Value="True" /><Condition Property="Small" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Width" Value="28" />
            </MultiTrigger>
            <!-- Default -->
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Variant" Value="Default" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Layer3Brush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Variant" Value="Default" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            </MultiTrigger>
            <!-- Primary -->
            <Trigger Property="Variant" Value="Primary">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Variant" Value="Primary" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Variant" Value="Primary" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            </MultiTrigger>
            <!-- Danger -->
            <Trigger Property="Variant" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Variant" Value="Danger" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
            </MultiTrigger>
            <!-- Ghost -->
            <Trigger Property="Variant" Value="Ghost">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="Variant" Value="Ghost" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Layer2Brush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Chips (recent searches, keywords, quick picks) -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Layer2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="999" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Layer3Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width list row button (.li) -->
    <Style x:Key="ListRow" TargetType="Button">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Layer2Brush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.6" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title-bar status chip -->
    <Style x:Key="StatusChip" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="8,0,10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Layer2Brush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caption buttons: 46 px wide, close turns red -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Layer3Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="Tag" Value="close" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hamburger / small square ghost icon button in the nav -->
    <Style x:Key="BurgerButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Layer2Brush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain text button (sort headers in the results list) -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" /></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation item ===== -->
    <Style TargetType="c:NavItem">
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NavItem">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                        <Grid>
                            <Border x:Name="PART_Pill" Width="3" Height="16" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <Grid Margin="14,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:Icon Kind="{TemplateBinding Icon}" Size="20" VerticalAlignment="Center" />
                                <TextBlock x:Name="Lbl" Grid.Column="1" Text="{TemplateBinding Content}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <c:Kbd x:Name="KbdBox" Grid.Column="2" Content="{TemplateBinding Kbd}" VerticalAlignment="Center" />
                                <Border x:Name="BadgeBox" Grid.Column="2" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Badge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <Ellipse x:Name="BadgeDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,4,0,0" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kbd" Value=""><Setter TargetName="KbdBox" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Badge" Value=""><Setter TargetName="BadgeBox" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Layer2Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource LayerBrush}" /></Trigger>
                        <Trigger Property="IsCurrent" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Layer2Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="PART_Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Collapsed" Value="True">
                            <Setter TargetName="Lbl" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="KbdBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BadgeBox" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="Collapsed" Value="True" /><Condition Property="Badge" Value="" /></MultiTrigger.Conditions>
                            <Setter TargetName="BadgeDot" Property="Opacity" Value="0" />
                        </MultiTrigger>
                        <Trigger Property="Collapsed" Value="True"><Setter TargetName="BadgeDot" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Settings section nav button ===== -->
    <Style x:Key="SectionNavButton" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <Grid>
                            <Border x:Name="Pill" Width="3" Height="14" CornerRadius="3" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Layer2Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter Property="Background" Value="{DynamicResource Layer2Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tabs ===== -->
    <Style x:Key="TabButton" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
            <Trigger Property="Tag" Value="on"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Segmented control ===== -->
    <Style x:Key="SegGroup" TargetType="Border">
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SegmentedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="SegButton" TargetType="RadioButton">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Background" Value="{DynamicResource Layer3Brush}" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Shadow1}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent swatches -->
    <Style x:Key="Swatch" TargetType="RadioButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="{TemplateBinding Background}">
                        <Border CornerRadius="6" BorderThickness="2" BorderBrush="#40000000" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextBrush}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08" /></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Toggle switch ===== -->
    <Style TargetType="c:ToggleSwitch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ToggleSwitch">
                    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{DynamicResource Text2Brush}" Background="Transparent">
                        <Ellipse x:Name="PART_Knob" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                 Fill="{DynamicResource Text2Brush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="PART_Knob" Property="Fill" Value="{DynamicResource TextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Knob" Property="Width" Value="14" />
                            <Setter TargetName="PART_Knob" Property="Height" Value="14" />
                            <Setter TargetName="PART_Knob" Property="Margin" Value="2,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Checkbox ===== -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Ring" Margin="-4" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Text2Brush}">
                                <c:Icon x:Name="Tick" Kind="i-check" Size="12" Thickness="2.2" Foreground="{DynamicResource TextOnAccentBrush}" Opacity="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A checkbox as a full card row (first-run folders) -->
    <Style x:Key="CheckRow" TargetType="CheckBox" BasedOn="{StaticResource Check}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <Border x:Name="Ring" Margin="-4" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Text2Brush}">
                                    <c:Icon x:Name="Tick" Kind="i-check" Size="12" Thickness="2.2" Foreground="{DynamicResource TextOnAccentBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Layer2Brush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text inputs ===== -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="Ph" Text="{TemplateBinding c:Field.Placeholder}" Foreground="{DynamicResource Text3Brush}" Margin="14,0,12,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" FontFamily="{TemplateBinding FontFamily}" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Margin="6,0" Background="{DynamicResource InputBottomBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Ph" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SunkenHoverBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SunkenFocusBrush}" />
                            <Setter TargetName="Line" Property="Height" Value="2" />
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="c:Field.IsInvalid" Value="True">
                            <Setter TargetName="Line" Property="Height" Value="2" />
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource ErrBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="InputMono" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- The bare text box inside the query box and the hero search -->
    <Style x:Key="BareInput" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="Ph" Text="{TemplateBinding c:Field.Placeholder}" Foreground="{DynamicResource Text3Brush}" Margin="2,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Ph" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider (Transparency effects) ===== -->
    <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="{DynamicResource SliderThumbBrush}" />
                        <Ellipse x:Name="Core" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Core" Property="Width" Value="10" />
                            <Setter TargetName="Core" Property="Height" Value="10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="UiSlider" TargetType="Slider">
        <Setter Property="Width" Value="180" />
        <Setter Property="Height" Value="20" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SliderTrackButton}" Background="{DynamicResource AccentBrush}" Command="Slider.DecreaseLarge" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SliderTrackButton}" Background="{DynamicResource Text3Brush}" Command="Slider.IncreaseLarge" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource SliderThumb}" /></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Pills, kbd, empty states ===== -->
    <Style TargetType="c:Pill">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource Layer2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Pill">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Dot x:Name="Dt" State="{TemplateBinding Dot}" Ring="False" Diameter="6" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <c:Icon x:Name="Ic" Kind="{TemplateBinding Icon}" Size="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Dot" Value=""><Setter TargetName="Dt" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Icon" Value=""><Setter TargetName="Ic" Property="Visibility" Value="Collapsed" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="ok">
                <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="warn">
                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="err">
                <Setter Property="Background" Value="{DynamicResource ErrSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ErrBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="acc">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="c:Kbd">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Kbd">
                    <Border CornerRadius="4" BorderBrush="{DynamicResource Stroke2Brush}" BorderThickness="1,1,1,2" Background="{DynamicResource LayerBrush}" Padding="6,1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:EmptyState">
        <Setter Property="MinHeight" Value="260" />
        <Setter Property="Padding" Value="24,48" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:EmptyState">
                    <Grid Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                        <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Extra}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <Border x:Name="Tile" Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Layer2Brush}" BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <c:Icon x:Name="Ic" Kind="{TemplateBinding Icon}" Size="28" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{TemplateBinding Title}" FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" />
                            <TextBlock x:Name="Msg" Text="{TemplateBinding Message}" Foreground="{DynamicResource Text2Brush}" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="380" Margin="0,10,0,0" LineHeight="20" />
                            <ContentPresenter Margin="0,14,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Message" Value=""><Setter TargetName="Msg" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Icon" Value=""><Setter TargetName="Tile" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Tone" Value="err">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ErrSoftBrush}" />
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource ErrLineBrush}" />
                            <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource ErrBrush}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="warn">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                            <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Dropdown button ===== -->
    <Style TargetType="c:DropDown">
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Layer2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:DropDown">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Key" Text="{TemplateBinding Label}" Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding ValueLabel}" VerticalAlignment="Center" />
                            <c:Icon x:Name="PART_Chevron" Kind="i-chev" Size="12" Foreground="{DynamicResource Text2Brush}" Margin="8,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <c:Icon.RenderTransform><RotateTransform /></c:Icon.RenderTransform>
                            </c:Icon>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value=""><Setter TargetName="Key" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Layer3Brush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Menu rows ===== -->
    <Style x:Key="MenuItemButton" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Layer3Brush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Layer3Brush}" /></Trigger>
            <Trigger Property="Tag" Value="danger"><Setter Property="Foreground" Value="{DynamicResource MenuDangerBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Scrollbars: thin, rounded, no arrows ===== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Margin="3" CornerRadius="5" Background="#1FFFFFFF" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#33FFFFFF" /></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#33FFFFFF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tooltips ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TooltipBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Stroke2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="8,4,8,12">
                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.4" /></Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lists ===== -->
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="ResultItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,8,14,8" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="Pill" Width="3" Height="18" CornerRadius="3" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource LayerBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Layer2Brush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ResultItemCompact" TargetType="ListBoxItem" BasedOn="{StaticResource ResultItem}">
        <Setter Property="Padding" Value="12,4,14,4" />
    </Style>
</ResourceDictionary>
