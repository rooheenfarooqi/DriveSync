<Window x:Class="DriveSync.App.Shell.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DriveSync.App.Controls"
        Title="DriveSync status" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource FontBody}" FontSize="13.5" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <!-- The tray flyout from the design (.flyout): status, three numbers and quick actions. -->
    <Border x:Name="Surface" Width="320" Margin="24,24,24,24" Padding="16" CornerRadius="12" BorderThickness="1"
            Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource Stroke2Brush}" Effect="{StaticResource ShadowMenu}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Image Source="/Assets/Logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DriveSync" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusLine" Style="{StaticResource Faint}" />
                </StackPanel>
            </StackPanel>
            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                    <DockPanel><TextBlock x:Name="FilesValue" DockPanel.Dock="Right" FontWeight="SemiBold" /><TextBlock Text="Files indexed" Foreground="{DynamicResource Text2Brush}" /></DockPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                    <DockPanel><TextBlock x:Name="RefreshValue" DockPanel.Dock="Right" FontWeight="SemiBold" /><TextBlock Text="Last refresh" Foreground="{DynamicResource Text2Brush}" /></DockPanel>
                </Border>
                <Border Grid.Row="2" Padding="0,8">
                    <DockPanel><TextBlock x:Name="ChangesValue" DockPanel.Dock="Right" FontWeight="SemiBold" /><TextBlock Text="Changes today" Foreground="{DynamicResource Text2Brush}" /></DockPanel>
                </Border>
            </Grid>
            <WrapPanel Margin="0,12,0,0">
                <c:UiButton x:Name="OpenButton" Variant="Primary" Small="True" Content="Open DriveSync" Margin="0,0,6,6" Click="Open_Click" />
                <c:UiButton x:Name="PauseButton" Small="True" Content="Pause" Margin="0,0,6,6" Click="Pause_Click" />
                <c:UiButton x:Name="RefreshButton" Small="True" Content="Refresh now" Margin="0,0,6,6" Click="Refresh_Click" />
                <c:UiButton Variant="Ghost" Small="True" Content="Quit" Margin="0,0,0,6" ToolTip="Quit DriveSync and stop watching" Click="Quit_Click" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
