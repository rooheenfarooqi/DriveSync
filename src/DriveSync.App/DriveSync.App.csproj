<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows desktop window (WPF). All the real work happens in DriveSync.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DriveSync</AssemblyName>
    <RootNamespace>DriveSync.App</RootNamespace>
    <!-- Lets the project also build on a non-Windows machine (it only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriveSync.Core\DriveSync.Core.csproj" />
  </ItemGroup>

</Project>
