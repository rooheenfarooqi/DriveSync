<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows desktop app (WPF). Indexing, search and parsing live in DriveSync.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the real system-tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DriveSync</AssemblyName>
    <RootNamespace>DriveSync.App</RootNamespace>
    <!-- The release version. A release is published by pushing the tag v<Version> (see .github/workflows/release.yml). -->
    <Version>0.9.0-beta.1</Version>
    <Product>DriveSync</Product>
    <Authors>Rooheen Farooqi</Authors>
    <Company>Rooheen Farooqi</Company>
    <Copyright>Copyright © 2026 Ayesha Riaz and Rooheen Ahmad Farooqi</Copyright>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>DriveSync.App.Program</StartupObject>
    <Description>Real-time desktop search engine for Windows</Description>
    <!-- Lets the project also build on a non-Windows machine (it only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The icon of DriveSync.exe in Explorer, the Start menu and the taskbar. Made by tools/make_icon.py. -->
    <ApplicationIcon>Assets\DriveSync.ico</ApplicationIcon>
    <!-- The installer build is precompiled, so DriveSync starts and opens previews without JIT warm-up. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for NotifyIcon; keep its names out of every WPF file. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DriveSync.ico" />
    <Resource Include="Assets\Logo.png" />
    <Resource Include="Assets\Splash.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installer, uninstaller and auto-updates from GitHub Releases. Keep in step with the vpk tool version. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriveSync.Core\DriveSync.Core.csproj" />
  </ItemGroup>

</Project>
