<Window x:Class="DriveSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriveSync" Height="720" Width="1200" MinHeight="400" MinWidth="960"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- title and search box -->
            <RowDefinition Height="*" />     <!-- results and preview -->
            <RowDefinition Height="Auto" />  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ===== Title and search box ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="DriveSync" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Choose a file type and, if you like, a folder to look in (or keep “All”), then type part of a file name. Separate words with spaces to narrow it down, e.g. “report 2026”."
                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="1. FILE TYPE" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="2. FOLDER (OPTIONAL)" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="3. FILE NAME" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />

                <!-- ===== File type picker: a box you can type in, with a searchable list below it ===== -->
                <Border x:Name="FormatBorder" Grid.Row="1" Grid.Column="0" Background="White"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FormatBox" FontSize="18" Padding="10,8" BorderThickness="0" Background="Transparent"
                                 TextChanged="FormatBox_TextChanged"
                                 PreviewKeyDown="FormatBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="FormatBox_PreviewMouseLeftButtonDown"
                                 GotKeyboardFocus="FormatBox_GotKeyboardFocus"
                                 LostKeyboardFocus="FormatBox_LostKeyboardFocus" />
                        <TextBlock x:Name="FormatPlaceholder" Text="All file types" FontSize="18"
                                   Margin="14,9" Foreground="#9CA3AF" IsHitTestVisible="False" />
                        <Button x:Name="ClearFormatButton" Grid.Column="1" Content="✕" ToolTip="Back to all file types"
                                Click="ClearFormatButton_Click" Visibility="Collapsed" Focusable="False"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                                Padding="6,0" Margin="0" />
                        <Button Grid.Column="2" Content="▾" ToolTip="Show all file types"
                                Click="ShowFormatsButton_Click" Focusable="False"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                                FontSize="16" Padding="10,0" Margin="0" />
                    </Grid>
                </Border>

                <Popup x:Name="FormatPopup" PlacementTarget="{Binding ElementName=FormatBorder}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" VerticalOffset="4"
                       Width="{Binding ActualWidth, ElementName=FormatBorder}">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="0,4">
                        <Grid>
                            <TextBlock x:Name="NoFormatsText" Text="No file type matches what you typed." Margin="12,8"
                                       Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />
                            <!-- Not focusable, so the keyboard stays in the box while you type and use the arrow keys. -->
                            <ListBox x:Name="FormatList" MaxHeight="380" BorderThickness="0" Focusable="False"
                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonUp="FormatList_PreviewMouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Padding" Value="10,5" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>

                <!-- ===== Folder picker: type a folder name or path, pick from the list, or Browse… ===== -->
                <Border x:Name="FolderBorder" Grid.Row="1" Grid.Column="2" Background="White"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" FontSize="18" Padding="10,8" BorderThickness="0" Background="Transparent"
                                 TextChanged="FolderBox_TextChanged"
                                 PreviewKeyDown="FolderBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="FolderBox_PreviewMouseLeftButtonDown"
                                 GotKeyboardFocus="FolderBox_GotKeyboardFocus"
                                 LostKeyboardFocus="FolderBox_LostKeyboardFocus" />
                        <TextBlock x:Name="FolderPlaceholder" Text="All drives" FontSize="18"
                                   Margin="14,9" Foreground="#9CA3AF" IsHitTestVisible="False" />
                        <Button x:Name="ClearFolderButton" Grid.Column="1" Content="✕" ToolTip="Back to all drives"
                                Click="ClearFolderButton_Click" Visibility="Collapsed" Focusable="False"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                                Padding="6,0" Margin="0" />
                        <Button Grid.Column="2" Content="Browse…" ToolTip="Choose a folder with the Windows folder dialog"
                                Click="BrowseFolderButton_Click" Focusable="False" Margin="0,0,6,0" Padding="10,3"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Popup x:Name="FolderPopup" PlacementTarget="{Binding ElementName=FolderBorder}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" VerticalOffset="4"
                       Width="{Binding ActualWidth, ElementName=FolderBorder}">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="0,4">
                        <Grid>
                            <TextBlock x:Name="NoFoldersText" Text="No folder matches what you typed." Margin="12,8"
                                       Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />
                            <ListBox x:Name="FolderList" MaxHeight="380" BorderThickness="0" Focusable="False"
                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonUp="FolderList_PreviewMouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Padding" Value="10,5" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Detail}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>

                <!-- ===== Search box ===== -->
                <Border Grid.Row="1" Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <TextBox x:Name="SearchBox" FontSize="18" Padding="10,8" BorderThickness="0" Background="Transparent"
                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <!-- Placeholder text, hidden as soon as something is typed -->
                        <TextBlock x:Name="SearchPlaceholder" Text="Search all files on this PC…" FontSize="18"
                                   Margin="14,9" Foreground="#9CA3AF" IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ===== Results (left) and preview (right) ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="ResultsList" Grid.Column="0" BorderBrush="{StaticResource BorderBrush}"
                      SelectionMode="Single"
                      SelectionChanged="ResultsList_SelectionChanged"
                      MouseDoubleClick="ResultsList_MouseDoubleClick"
                      KeyDown="ResultsList_KeyDown"
                      VirtualizingPanel.IsVirtualizing="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Folder" Width="320" DisplayMemberBinding="{Binding Folder}" />
                        <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="Modified" Width="130" DisplayMemberBinding="{Binding ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="EmptyPreviewText" Text="Select a file to see its summary and preview."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                        <StackPanel x:Name="PreviewPanel" Visibility="Collapsed">
                            <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="FileDetailsText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="FilePathText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,10" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open" Click="OpenButton_Click" />
                                <Button Content="Show in folder" Click="ShowInFolderButton_Click" />
                                <Button Content="Search in this folder" Click="SearchInFolderButton_Click"
                                        ToolTip="Limit the search to the folder this file is in" />
                            </StackPanel>

                            <TextBlock Text="KEYWORDS" Style="{StaticResource SectionHeading}" x:Name="KeywordsHeading" />
                            <ItemsControl x:Name="KeywordsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="SUMMARY" Style="{StaticResource SectionHeading}" />
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" LineHeight="20" />

                            <TextBlock Text="PREVIEW" Style="{StaticResource SectionHeading}" x:Name="PreviewHeading" />
                            <Image x:Name="PreviewImage" MaxHeight="360" Stretch="Uniform" HorizontalAlignment="Left" />
                            <TextBox x:Name="PreviewTextBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                     Background="#F9FAFB" Padding="8" FontFamily="Consolas" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Starting…" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" />
            <TextBlock x:Name="SearchTimeText" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
