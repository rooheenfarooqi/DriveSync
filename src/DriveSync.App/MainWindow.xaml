<Window x:Class="DriveSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DriveSync.App.Controls"
        Title="DriveSync" Icon="Assets/DriveSync.ico"
        Width="1360" Height="860" MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{StaticResource FontBody}" FontSize="13.5" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource WindowSurfaceBrush}">
        <Grid x:Name="ShellGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar: logo, name, breadcrumb, live status chip, caption buttons ===== -->
            <Grid x:Name="TitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Logo.png" Width="18" Height="18" Margin="16,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1" Text="DriveSync" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                <StackPanel x:Name="Crumb" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <c:Icon Kind="i-chev-r" Size="16" Foreground="{DynamicResource Text3Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CrumbText" FontSize="12.5" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="StatusChip" Grid.Column="4" Style="{StaticResource StatusChip}" Margin="0,0,12,0" VerticalAlignment="Center"
                        ToolTip="Open Activity" Click="StatusChip_Click" AutomationProperties.Name="Indexing status. Open Live activity">
                    <StackPanel Orientation="Horizontal">
                        <c:Dot x:Name="StatusDot" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0" VerticalAlignment="Center" Text="Starting…" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="CaptionButtons" Grid.Column="5" Orientation="Horizontal">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="Min_Click" AutomationProperties.Name="Minimize">
                        <c:Icon Kind="i-win-min" Box="10" Size="10" Thickness="1" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Max_Click" AutomationProperties.Name="Maximize">
                        <c:Icon x:Name="MaxIcon" Kind="i-win-max" Box="10" Size="10" Thickness="1" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Tag="close" Click="Close_Click" AutomationProperties.Name="Close to tray">
                        <c:Icon Kind="i-win-close" Box="10" Size="10" Thickness="1" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Navigation and content ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="NavHost" Width="236" ClipToBounds="True">
                    <Grid Margin="8,8,8,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="Burger" Style="{StaticResource BurgerButton}" HorizontalAlignment="Left" Margin="2,0,0,6"
                                ToolTip="Collapse navigation" AutomationProperties.Name="Collapse navigation" Click="Burger_Click">
                            <c:Icon Kind="i-menu" Size="16" />
                        </Button>
                        <StackPanel Grid.Row="1" x:Name="NavItems">
                            <c:NavItem x:Name="NavHome" Icon="i-home" Content="Home" Tag="home" Click="Nav_Click" ToolTip="Home (Alt+1)" />
                            <c:NavItem x:Name="NavSearch" Icon="i-search" Content="Search" Kbd="Ctrl K" Tag="search" Click="Nav_Click" ToolTip="Search (Alt+2)" />
                            <c:NavItem x:Name="NavFolders" Icon="i-folder" Content="Indexed folders" Tag="folders" Click="Nav_Click" ToolTip="Indexed folders (Alt+3)" />
                            <c:NavItem x:Name="NavActivity" Icon="i-pulse" Content="Live activity" Tag="activity" Click="Nav_Click" ToolTip="Live activity (Alt+4)" />
                            <c:NavItem x:Name="NavBench" Icon="i-gauge" Content="Benchmarks" Tag="benchmarks" Click="Nav_Click" ToolTip="Benchmarks (Alt+5)" />
                        </StackPanel>
                        <!-- Indexing status card -->
                        <Border x:Name="Mini" Grid.Row="3" Margin="2,6,2,8" Padding="12" CornerRadius="12" BorderThickness="1"
                                Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource StrokeBrush}">
                            <StackPanel>
                                <DockPanel>
                                    <c:Dot x:Name="MiniDot" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MiniPct" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MiniTitle" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock x:Name="MiniSub" FontSize="11.5" Foreground="{DynamicResource Text3Brush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <c:ProgressLine x:Name="MiniBar" Margin="0,8,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <c:NavItem x:Name="NavSettings" Grid.Row="4" Icon="i-gear" Content="Settings" Tag="preferences" Click="Nav_Click" Margin="0" ToolTip="Settings (Ctrl+,)" />
                    </Grid>
                </Border>

                <Border x:Name="ContentHost" Grid.Column="1" Background="{DynamicResource ContentBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1,1,0,0" CornerRadius="12,0,0,0" ClipToBounds="True">
                    <Grid x:Name="PageHost" />
                </Border>
            </Grid>
        </Grid>

        <!-- Inset hairline along the top edge of the window -->
        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource HairlineTopBrush}" IsHitTestVisible="False" />

        <!-- ===== Dialogs ===== -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
            <Border x:Name="DialogSurface" Margin="16" VerticalAlignment="Center" CornerRadius="16" BorderThickness="1"
                    Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource Stroke2Brush}" Effect="{StaticResource ShadowDialog}"
                    KeyboardNavigation.TabNavigation="Cycle" />
        </Grid>

        <!-- ===== Toasts ===== -->
        <StackPanel x:Name="ToastPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="360" Margin="16" />
    </Grid>
</Window>
