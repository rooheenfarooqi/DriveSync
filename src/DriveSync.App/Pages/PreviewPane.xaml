<UserControl x:Class="DriveSync.App.Pages.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DriveSync.App.Controls">
    <!-- The preview pane (.preview): header, actions, Summary / Outline / Details tabs and their states. -->
    <Grid>
        <c:EmptyState x:Name="Empty" Icon="i-sparkle" Title="Preview before you open"
                      Message="Select a file to see a short summary, its outline and its details. DriveSync reads the file only when you ask." />

        <Grid x:Name="Filled" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="20,20,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:FileGlyph x:Name="Glyph" Large="True" VerticalAlignment="Top" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PathText" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{DynamicResource Text3Brush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <WrapPanel x:Name="Pills" Margin="0,8,0,0" />
                </StackPanel>
                <c:UiButton x:Name="CloseButton" Grid.Column="2" Variant="Ghost" Small="True" IconOnly="True" Icon="i-x" VerticalAlignment="Top"
                            ToolTip="Close preview" AutomationProperties.Name="Close preview" Visibility="Collapsed" Click="Close_Click" />
            </Grid>

            <!-- Actions -->
            <WrapPanel Grid.Row="1" Margin="20,0,20,16">
                <c:UiButton Variant="Primary" Small="True" Icon="i-open" Content="Open" Margin="0,0,6,6" Click="Open_Click" />
                <c:UiButton Small="True" Icon="i-folder-open" Content="Show in folder" Margin="0,0,6,6" Click="Reveal_Click" />
                <c:UiButton Small="True" IconOnly="True" Icon="i-copy" ToolTip="Copy path" AutomationProperties.Name="Copy path" Margin="0,0,6,6" Click="Copy_Click" />
                <c:UiButton x:Name="MoreButton" Small="True" IconOnly="True" Icon="i-more" ToolTip="More" AutomationProperties.Name="More actions" Margin="0,0,6,6" Click="More_Click" />
            </WrapPanel>

            <!-- Tabs -->
            <Border Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StrokeBrush}" Padding="20,0">
                <c:TabBar x:Name="Tabs" />
            </Border>

            <!-- Body -->
            <ScrollViewer x:Name="BodyScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="Body" Margin="20" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
